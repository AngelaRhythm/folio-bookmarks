{
  "manifest_version": 3,
  "name": "Folio 视觉书签画廊",
  "version": "1.0.0",
  "description": "极简、沉浸式的 Chrome 书签首屏画廊新标签页，实时联动原生书签，支持无感首屏截屏与智能分组建议。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
